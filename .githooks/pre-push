#!/usr/bin/env bash
# Se il push include commit che modificano landing_page/, la pubblica su Tophost via FTP.
# Attivo solo su questa macchina (git config core.hooksPath .githooks); non gira su CI:
# vedi la nota nello script scripts/ftp-deploy-landing.sh sul blocco FTP di Tophost
# verso gli IP dei runner GitHub Actions.
set -euo pipefail

ZERO="0000000000000000000000000000000000000000"
REPO_ROOT="$(git rev-parse --show-toplevel)"
changed=0

while read -r local_ref local_sha remote_ref remote_sha; do
  [ -z "$local_sha" ] && continue
  [ "$local_sha" = "$ZERO" ] && continue  # cancellazione di branch/tag

  if [ "$remote_sha" = "$ZERO" ]; then
    # branch nuovo sul remoto: confronta con il primo commit del branch
    base="$(git rev-list --max-parents=0 "$local_sha" | tail -1)"
  else
    base="$remote_sha"
  fi

  if ! git diff --quiet "$base" "$local_sha" -- landing_page/ 2>/dev/null; then
    changed=1
  fi
done

if [ "$changed" = "1" ]; then
  echo "pre-push: landing_page/ è cambiata, eseguo il deploy FTP..."
  "$REPO_ROOT/scripts/ftp-deploy-landing.sh"
fi

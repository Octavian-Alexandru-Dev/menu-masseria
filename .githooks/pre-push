#!/usr/bin/env bash
# Se il push include commit che modificano landing_page/, la pubblica su Tophost via FTP.
# Attivo solo su questa macchina (git config core.hooksPath .githooks); non gira su CI:
# vedi la nota nello script scripts/ftp-deploy-landing.sh sul blocco FTP di Tophost
# verso gli IP dei runner GitHub Actions.
set -euo pipefail

ZERO="0000000000000000000000000000000000000000"
REPO_ROOT="$(git rev-parse --show-toplevel)"
changed=0

while read -r local_ref local_sha remote_ref remote_sha; do
  [ -z "$local_sha" ] && continue
  [ "$local_sha" = "$ZERO" ] && continue  # cancellazione di branch/tag

  if [ "$remote_sha" = "$ZERO" ]; then
    # branch nuovo sul remoto: confronta con il primo commit del branch
    base="$(git rev-list --max-parents=0 "$local_sha" | tail -1)"
  else
    base="$remote_sha"
  fi

  if ! git diff --quiet "$base" "$local_sha" -- landing_page/ 2>/dev/null; then
    changed=1
  fi
done

if [ "$changed" = "1" ]; then
  echo "pre-push: landing_page/ è cambiata, eseguo il deploy FTP..."
  if [ -f "$REPO_ROOT/.bws-token" ] && command -v bws >/dev/null 2>&1; then
    # Credenziali da Bitwarden Secrets Manager (progetto "Menu-masseria"):
    # bws inietta FTP_HOST/FTP_USERNAME/FTP_PASSWORD come variabili
    # d'ambiente nel processo figlio, senza mai scriverle su disco.
    (
      # shellcheck disable=SC1091
      source "$REPO_ROOT/.bws-token"
      bws run --project-id "$BWS_PROJECT_ID" --access-token "$BWS_ACCESS_TOKEN" \
        --server-url "$BWS_SERVER_URL" \
        -- "$REPO_ROOT/scripts/ftp-deploy-landing.sh"
    )
  else
    # Fallback: nessun accesso a Bitwarden su questa macchina, usa il file
    # locale .ftp-credentials (letto direttamente da ftp-deploy-landing.sh).
    "$REPO_ROOT/scripts/ftp-deploy-landing.sh"
  fi
fi

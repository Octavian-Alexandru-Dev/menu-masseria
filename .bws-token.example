# Copia questo file in `.bws-token` (root del repo, già escluso da git) per
# generare .env da Bitwarden Secrets Manager con scripts/bws-env.sh, invece
# di copiare .env.example a mano. Richiede la CLI `bws` (`cargo install bws`).
BWS_ACCESS_TOKEN='<access token del machine account, da Bitwarden>'
BWS_PROJECT_ID='<id del progetto "Menu-masseria" in Secrets Manager>'
BWS_SERVER_URL='https://vault.bitwarden.eu'

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Personale = account con un documento staff/{uid} e un ruolo in uso
    // (admin/waiter). Non basta essere autenticati: con l'email/password
    // abilitata chiunque conosca la chiave web pubblica può crearsi un
    // account Firebase Auth (è anche così che l'app crea gli account dalle
    // Impostazioni > Personale, vedi src/firebase-auth.js), quindi i dati
    // dello staff si aprono solo a chi un amministratore ha dato un ruolo.
    // Costo: una lettura in più di staff/{uid} per richiesta (Firestore la
    // conta una sola volta anche se più regole la usano).
    function staffRole() {
      return get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.role;
    }
    function isStaff() {
      return request.auth != null
        && exists(/databases/$(database)/documents/staff/$(request.auth.uid))
        && staffRole() in ['admin', 'waiter'];
    }
    function isAdmin() {
      return isStaff() && staffRole() == 'admin';
    }

    // Il menù è pubblico in lettura (lo vedono i clienti),
    // ma può essere modificato solo dal personale.
    match /menu/data {
      allow read: if true;
      allow write: if isStaff();
    }

    // Costi interni dei piatti (per il margine nella Dashboard statistiche):
    // documento separato da menu/data apposta, perché quello è pubblico e
    // Firestore non ha regole per singolo campo — se il costo fosse dentro
    // menu/data, chiunque visitasse il menù senza autenticarsi lo vedrebbe
    // nella risposta di rete anche a UI nascosta.
    match /menuCosts/data {
      allow read, write: if isStaff();
    }

    // Ruoli del personale (admin/waiter). Ognuno legge il proprio documento
    // (anche se non esiste: è così che l'app scopre "nessun ruolo" dopo il
    // login, staff-shared.jsx); l'elenco lo legge il personale; solo un
    // amministratore assegna o toglie ruoli (Impostazioni > Personale). Il
    // primo amministratore di un progetto nuovo si crea a mano in Firebase
    // Console (vedi GUIDA.md).
    match /staff/{uid} {
      allow read: if (request.auth != null && request.auth.uid == uid) || isStaff();
      allow write: if isAdmin();
    }

    // Comande dei tavoli. La distinzione dei ruoli (cameriere vs
    // amministratore) è imposta dall'interfaccia, non da regole separate per
    // campo: qui basta essere personale.
    match /orders/{orderId} {
      allow read, write: if isStaff();
    }

    // Prenotazioni tavoli, inserite manualmente da cameriere/amministrazione
    // (vedi docs/prenotazioni.md). Le crea, modifica, annulla e avvia tutto il
    // personale; eliminarle per sempre (swipe o "Elimina", TillReservations.jsx)
    // può solo un amministratore. Eccezione: quelle scadute (expireAt passato,
    // 30 giorni dopo annullamento/mancata presentazione) le toglie la pulizia
    // automatica da qualunque dispositivo dello staff
    // (runDailyExpiredReservationsCleanup in src/reservationsData.js).
    match /reservations/{reservationId} {
      allow read, create, update: if isStaff();
      allow delete: if isAdmin()
        || (isStaff() && resource.data.get('expireAt', null) != null && resource.data.expireAt <= request.time);
    }

    // Coda di stampa dei preconti verso la stampante termica della cassa
    // (vedi docs/stampa-scontrini.md): qualunque dispositivo dello staff
    // accoda una stampa, il client Windows della cassa la prende in carico e
    // ne aggiorna lo stato. Stesso confine delle comande.
    match /printJobs/{jobId} {
      allow read, write: if isStaff();
    }

    // Visite al menù pubblico, un contatore per giorno (src/menuViews.js,
    // mostrato in Statistiche). Il menù lo apre chiunque senza account, quindi
    // la scrittura è pubblica ma ridotta al minimo: si può solo far partire
    // un giorno da 1 o aggiungergli 1, nessun altro campo; lo legge solo il
    // personale.
    match /menuViews/{day} {
      allow read: if isStaff();
      allow create: if day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['count'])
        && request.resource.data.count == 1;
      allow update: if request.resource.data.keys().hasOnly(['count'])
        && request.resource.data.count == resource.data.count + 1;
      allow delete: if false;
    }

    // Tutto il resto è bloccato per sicurezza.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

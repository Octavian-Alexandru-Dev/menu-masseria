# Copia questo file in ".env" e incolla i valori presi dalla console Firebase
# (Impostazioni progetto → Generali → "Le tue app" → app web).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Modalità locale senza Firebase reale: `npm run dev:local` avvia gli
# emulatori Firebase in Docker (docker-compose.emulator.yml) e imposta questo
# flag da solo. Se vuoi impostarlo a mano, i sei valori VITE_FIREBASE_* sopra
# possono restare placeholder qualsiasi (es. "demo-key" / "demo-masseria-test"
# / ecc.): l'emulatore li ignora, non serve un vero progetto Firebase.
VITE_USE_FIREBASE_EMULATOR=

# Upload foto piatti (Cloudinary, piano gratuito) — vedi GUIDA.md, sezione
# "Foto dei piatti (Cloudinary)" per come ottenere questi due valori.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

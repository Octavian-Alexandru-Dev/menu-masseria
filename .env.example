# Copia questo file in ".env" e incolla i valori presi dalla console Firebase
# (Impostazioni progetto → Generali → "Le tue app" → app web).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Upload foto piatti (Cloudinary, piano gratuito) — vedi GUIDA.md, sezione
# "Foto dei piatti (Cloudinary)" per come ottenere questi due valori.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

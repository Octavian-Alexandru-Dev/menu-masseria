{
  "name": "masseria-cassa",
  "productName": "Masseria Cassa",
  "version": "1.0.0",
  "description": "Client Windows della cassa: interfaccia web dello staff + stampa diretta dei preconti sulla stampante termica.",
  "private": true,
  "author": "Fattoria della Piana",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "44.4.3",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "it.masseria-della-piana.cassa",
    "productName": "Masseria Cassa",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["src/**/*", "build/icon.png", "package.json"],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Masseria Cassa",
      "artifactName": "Masseria-Cassa-Setup.exe"
    }
  }
}

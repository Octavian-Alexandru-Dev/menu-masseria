{
  "name": "masseria-della-piana-menu",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:local": "npm run emulators:up && npm run seed:emulator && VITE_USE_FIREBASE_EMULATOR=true VITE_FIREBASE_API_KEY=demo-key VITE_FIREBASE_PROJECT_ID=demo-masseria-test vite",
    "build": "vite build",
    "preview": "vite preview",
    "emulators:up": "docker compose -f docker-compose.emulator.yml up -d --wait",
    "emulators:down": "docker compose -f docker-compose.emulator.yml down",
    "seed:emulator": "node scripts/seed-emulator.js",
    "seed:export": "bash scripts/export-seed-data.sh",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "firebase": "^10.13.0",
    "lucide-react": "^0.383.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@vitejs/plugin-react": "^4.3.1",
    "dotenv": "^17.4.2",
    "vite": "^5.4.0"
  }
}
